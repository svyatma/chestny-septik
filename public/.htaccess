<Files "index.html">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
</Files>

<FilesMatch "\.(css|js|webp|png|jpg|jpeg|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# Отключаем MultiViews, чтобы Apache не подбирал похожие файлы
Options -MultiViews

RewriteEngine On
RewriteBase /

# 1. Пропускаем реальные файлы и папки (CSS, JS, картинки)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 2. Разрешённые SPA-маршруты – отдаём index.html с кодом 200
#    (добавляй сюда каждый новый путь из React Router)
RewriteCond %{REQUEST_URI} ^/$ [OR]
RewriteCond %{REQUEST_URI} ^/catalog/?$ [OR]
RewriteCond %{REQUEST_URI} ^/septik-na-3-cheloveka/?$ [OR]
RewriteCond %{REQUEST_URI} ^/septik-dlya-chastnogo-doma/?$ [OR]
RewriteCond %{REQUEST_URI} ^/septik-dlya-dachi/?$ [OR]
RewriteCond %{REQUEST_URI} ^/politika-obrabotki-dannyh/?$ [OR]
RewriteCond %{REQUEST_URI} ^/politika-cookies/?$ [OR]
RewriteCond %{REQUEST_URI} ^/septiki-evrobion/?$ [OR]
RewriteCond %{REQUEST_URI} ^/septiki-topas/?$ [OR]
RewriteCond %{REQUEST_URI} ^/septiki-astra/?$ [OR]
RewriteCond %{REQUEST_URI} ^/septiki-evrolos/?$ [OR]
RewriteCond %{REQUEST_URI} ^/septiki-zorde/?$
RewriteRule ^ /index.html [L]

# 3. Для всех остальных URL – возвращаем 404, но в качестве содержимого
#    отдаём index.html. React сам покажет страницу NotFound.
ErrorDocument 404 /index.html